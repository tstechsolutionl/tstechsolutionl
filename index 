<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="TS TECHSOLUTIONL — Mechanical Engineering, Manufacturing, Product Development, Visualization, Digital and Web Solutions.">

  <meta name="keywords"
        content="TS TECHSOLUTIONL, Mechanical Engineering, CAD Design, Machine Design, CNC, 3D Printing, Manufacturing, Product Development, 3D Visualization, Web Development">

  <meta name="author"
        content="TS TECHSOLUTIONL">

  <meta name="theme-color"
        content="#06111f">

  <title>
    TS TECHSOLUTIONL | Engineering • Manufacturing • Digital
  </title>


  <style>

    /* =====================================================
       RESET
    ===================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }


    /* =====================================================
       VARIABLES
    ===================================================== */

    :root {

      --background: #050b14;

      --background-2: #071321;

      --card: #0b1726;

      --card-light: #0e1d30;

      --blue: #1688ff;

      --blue-light: #39adff;

      --cyan: #27d9ff;

      --white: #ffffff;

      --text: #dce7f3;

      --muted: #91a4b8;

      --border: rgba(255,255,255,0.09);

      --shadow:
        0 25px 70px rgba(0,0,0,0.38);

      --radius: 18px;
    }


    /* =====================================================
       BODY
    ===================================================== */

    body {

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      color: var(--white);

      background:

        radial-gradient(
          circle at 80% 10%,
          rgba(22,136,255,.13),
          transparent 30%
        ),

        radial-gradient(
          circle at 10% 50%,
          rgba(39,217,255,.06),
          transparent 25%
        ),

        var(--background);

      line-height: 1.6;

      overflow-x: hidden;
    }


    a {

      color: inherit;

      text-decoration: none;
    }


    img {

      max-width: 100%;

      display: block;
    }


    .container {

      width: min(1180px,92%);

      margin: auto;
    }


    section {

      padding: 100px 0;

      position: relative;
    }


    .section-label {

      color: var(--blue-light);

      text-transform: uppercase;

      letter-spacing: 3px;

      font-size: 12px;

      font-weight: 800;

      margin-bottom: 12px;
    }


    .section-title {

      font-size:
        clamp(32px,5vw,54px);

      line-height: 1.08;

      letter-spacing: -1px;

      margin-bottom: 20px;
    }


    .section-description {

      max-width: 720px;

      color: var(--muted);

      font-size: 17px;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    header {

      position: fixed;

      top: 0;

      left: 0;

      width: 100%;

      z-index: 1000;

      background:
        rgba(5,11,20,.82);

      backdrop-filter: blur(18px);

      border-bottom:
        1px solid var(--border);
    }


    .nav {

      min-height: 76px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 25px;
    }


    .logo {

      font-size: 21px;

      font-weight: 900;

      letter-spacing: .5px;

      white-space: nowrap;
    }


    .logo span {

      color: var(--blue-light);
    }


    .nav-links {

      list-style: none;

      display: flex;

      align-items: center;

      gap: 24px;
    }


    .nav-links a {

      color: #c9d6e4;

      font-size: 14px;

      font-weight: 600;

      transition: .3s;
    }


    .nav-links a:hover {

      color: var(--blue-light);
    }


    .nav-cta {

      padding: 11px 18px;

      border-radius: 9px;

      background: var(--blue);

      color: white !important;
    }


    .nav-cta:hover {

      background: var(--blue-light);
    }


    .menu-btn {

      display: none;

      border: none;

      background: none;

      color: white;

      font-size: 28px;

      cursor: pointer;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero {

      min-height: 100vh;

      display: flex;

      align-items: center;

      padding-top: 125px;

      overflow: hidden;
    }


    .hero-grid {

      display: grid;

      grid-template-columns:
        1.08fr .92fr;

      gap: 70px;

      align-items: center;
    }


    .hero h1 {

      font-size:
        clamp(45px,7vw,82px);

      line-height: .98;

      letter-spacing: -3px;

      margin-bottom: 25px;
    }


    .hero h1 span {

      display: block;

      background:
        linear-gradient(
          90deg,
          white,
          var(--blue-light)
        );

      -webkit-background-clip: text;

      color: transparent;
    }


    .hero p {

      color: var(--muted);

      font-size: 18px;

      max-width: 680px;

      margin-bottom: 35px;
    }


    .hero-buttons {

      display: flex;

      flex-wrap: wrap;

      gap: 14px;
    }


    .btn {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      padding: 14px 23px;

      border-radius: 10px;

      border: 1px solid var(--border);

      font-weight: 700;

      font-size: 14px;

      transition: .3s;
    }


    .btn-primary {

      background: var(--blue);

      border-color: var(--blue);
    }


    .btn-primary:hover {

      background: var(--blue-light);

      transform: translateY(-3px);
    }


    .btn-outline:hover {

      border-color:
        var(--blue-light);

      color:
        var(--blue-light);

      transform:
        translateY(-3px);
    }


    /* =====================================================
       HERO VISUAL
    ===================================================== */

    .hero-visual {

      min-height: 440px;

      position: relative;

      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius: 30px;

      background:

        linear-gradient(
          135deg,
          rgba(22,136,255,.15),
          transparent 55%
        ),

        #081321;

      box-shadow:
        var(--shadow);
    }


    .technical-grid {

      position: absolute;

      inset: 0;

      background-image:

        linear-gradient(
          rgba(255,255,255,.035) 1px,
          transparent 1px
        ),

        linear-gradient(
          90deg,
          rgba(255,255,255,.035) 1px,
          transparent 1px
        );

      background-size:
        35px 35px;
    }


    .machine {

      position: absolute;

      inset: 13%;

      border:
        2px solid
        rgba(57,173,255,.65);

      border-radius: 14px;

      transform:
        perspective(700px)
        rotateX(55deg)
        rotateZ(-25deg);

      box-shadow:

        0 0 35px
        rgba(22,136,255,.18),

        inset 0 0 35px
        rgba(22,136,255,.08);

      animation:
        machineFloat 5s ease-in-out infinite;
    }


    .machine::before {

      content: "";

      position: absolute;

      width: 55%;

      height: 55%;

      left: 22%;

      top: 22%;

      border:
        2px solid
        rgba(39,217,255,.55);
    }


    .machine::after {

      content: "";

      position: absolute;

      width: 25%;

      height: 25%;

      left: 38%;

      top: 38%;

      background:
        rgba(22,136,255,.12);

      border:
        2px solid
        rgba(39,217,255,.55);
    }


    @keyframes machineFloat {

      0%,
      100% {

        transform:
          perspective(700px)
          rotateX(55deg)
          rotateZ(-25deg)
          translateY(0);
      }

      50% {

        transform:
          perspective(700px)
          rotateX(55deg)
          rotateZ(-25deg)
          translateY(-14px);
      }
    }


    .hero-badge {

      position: absolute;

      left: 25px;

      right: 25px;

      bottom: 25px;

      padding: 16px;

      background:
        rgba(5,11,20,.82);

      backdrop-filter:
        blur(12px);

      border:
        1px solid var(--border);

      border-radius: 13px;
    }


    .hero-badge strong {

      display: block;

      margin-bottom: 3px;
    }


    .hero-badge span {

      color: var(--muted);

      font-size: 13px;
    }


    /* =====================================================
       STATS
    ===================================================== */

    .stats {

      padding: 35px 0;

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);

      background:
        rgba(255,255,255,.015);
    }


    .stats-grid {

      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 20px;
    }


    .stat {

      text-align: center;
    }


    .stat strong {

      display: block;

      color:
        var(--blue-light);

      font-size: 32px;
    }


    .stat span {

      color: var(--muted);

      font-size: 13px;
    }


    /* =====================================================
       SERVICES
    ===================================================== */

    .services-grid {

      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 18px;

      margin-top: 50px;
    }


    .service-card {

      min-height: 300px;

      padding: 30px;

      position: relative;

      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius:
        var(--radius);

      background:
        linear-gradient(
          145deg,
          var(--card-light),
          var(--card)
        );

      transition: .35s;
    }


    .service-card::before {

      content: "";

      position: absolute;

      width: 120px;

      height: 120px;

      right: -50px;

      top: -50px;

      border-radius: 50%;

      background:
        rgba(22,136,255,.12);
    }


    .service-card:hover {

      transform:
        translateY(-8px);

      border-color:
        rgba(57,173,255,.5);

      box-shadow:
        var(--shadow);
    }


    .service-icon {

      width: 55px;

      height: 55px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      background:
        rgba(22,136,255,.1);

      border:
        1px solid
        rgba(57,173,255,.25);

      font-size: 25px;

      margin-bottom: 25px;
    }


    .service-card h3 {

      font-size: 21px;

      margin-bottom: 13px;
    }


    .service-card p {

      color: var(--muted);

      font-size: 14px;

      margin-bottom: 25px;
    }


    .service-link {

      color:
        var(--blue-light);

      font-size: 13px;

      font-weight: 700;
    }


    /* =====================================================
       CAPABILITIES
    ===================================================== */

    .capabilities {

      background:
        #07111e;
    }


    .cap-grid {

      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 12px;

      margin-top: 45px;
    }


    .cap {

      padding: 18px;

      border:
        1px solid var(--border);

      background:
        rgba(255,255,255,.025);

      border-radius: 10px;

      color: #d8e5f2;

      transition: .25s;
    }


    .cap:hover {

      border-color:
        rgba(57,173,255,.5);

      transform:
        translateY(-3px);
    }


    .cap span {

      color:
        var(--blue-light);

      margin-right: 9px;
    }


    /* =====================================================
       PROCESS
    ===================================================== */

    .process-grid {

      display: grid;

      grid-template-columns:
        repeat(6,1fr);

      gap: 10px;

      margin-top: 55px;
    }


    .process-step {

      text-align: center;
    }


    .process-number {

      width: 55px;

      height: 55px;

      margin:
        auto auto 15px;

      display: grid;

      place-items: center;

      border-radius: 50%;

      color:
        var(--blue-light);

      background:
        rgba(22,136,255,.1);

      border:
        1px solid
        rgba(57,173,255,.4);

      font-weight: 800;
    }


    .process-step h3 {

      font-size: 15px;
    }


    .process-step p {

      color:
        var(--muted);

      font-size: 12px;

      margin-top: 5px;
    }


    /* =====================================================
       PROJECTS
    ===================================================== */

    .projects {

      background:
        #07111e;
    }


    .project-grid {

      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 20px;

      margin-top: 50px;
    }


    .project-card {

      overflow: hidden;

      background:
        var(--card);

      border:
        1px solid var(--border);

      border-radius:
        var(--radius);

      transition: .35s;
    }


    .project-card:hover {

      transform:
        translateY(-7px);

      border-color:
        rgba(57,173,255,.45);
    }


    .project-image {

      height: 220px;

      display: grid;

      place-items: center;

      position: relative;

      overflow: hidden;

      background:

        linear-gradient(
          135deg,
          rgba(22,136,255,.2),
          rgba(5,11,20,.9)
        );
    }


    .project-image::before {

      content:
        "ENGINEERING";

      position: absolute;

      font-size: 43px;

      font-weight: 900;

      letter-spacing: 5px;

      color:
        rgba(255,255,255,.045);

      transform:
        rotate(-20deg);
    }


    .project-symbol {

      position: relative;

      z-index: 2;

      font-size: 65px;
    }


    .project-content {

      padding: 25px;
    }


    .project-content h3 {

      margin-bottom: 9px;
    }


    .project-content p {

      color:
        var(--muted);

      font-size: 14px;

      margin-bottom: 17px;
    }


    .tag {

      display: inline-block;

      padding: 5px 9px;

      margin: 2px;

      border:
        1px solid var(--border);

      border-radius: 6px;

      color:
        var(--blue-light);

      font-size: 11px;
    }


    /* =====================================================
       CAREERS
    ===================================================== */

    .careers-header {

      margin-bottom: 45px;
    }


    .careers-banner {

      padding: 45px;

      margin-bottom: 30px;

      border:
        1px solid
        rgba(57,173,255,.2);

      border-radius: 25px;

      background:

        linear-gradient(
          120deg,
          rgba(22,136,255,.15),
          rgba(39,217,255,.04)
        ),

        var(--card);
    }


    .careers-banner h3 {

      font-size: 30px;

      margin-bottom: 12px;
    }


    .careers-banner p {

      color:
        var(--muted);

      max-width: 750px;
    }


    .jobs {

      display: grid;

      grid-template-columns:
        repeat(2,1fr);

      gap: 15px;
    }


    .job {

      padding: 25px;

      border:
        1px solid var(--border);

      border-radius: 14px;

      background:
        rgba(255,255,255,.025);

      transition: .3s;
    }


    .job:hover {

      border-color:
        rgba(57,173,255,.45);

      transform:
        translateY(-3px);
    }


    .job h3 {

      margin-bottom: 8px;
    }


    .job p {

      color:
        var(--muted);

      font-size: 13px;

      margin-bottom: 15px;
    }


    .job small {

      color:
        var(--blue-light);
    }


    .career-cta {

      margin-top: 25px;

      padding: 28px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      border:
        1px solid var(--border);

      border-radius: 15px;
    }


    .career-cta p {

      color:
        var(--muted);

      font-size: 14px;
    }


    /* =====================================================
       ABOUT
    ===================================================== */

    .about-grid {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 70px;

      align-items: center;
    }


    .about-box {

      padding: 35px;

      border:
        1px solid var(--border);

      border-radius: 20px;

      background:
        linear-gradient(
          145deg,
          var(--card-light),
          var(--card)
        );
    }


    .about-box h3 {

      font-size: 27px;

      margin-bottom: 15px;
    }


    .about-box p {

      color:
        var(--muted);

      margin-bottom: 15px;
    }


    .values {

      display: grid;

      gap: 13px;

      margin-top: 25px;
    }


    .value {

      padding: 17px;

      border-left:
        3px solid var(--blue);

      background:
        rgba(255,255,255,.025);
    }


    .value strong {

      display: block;

      margin-bottom: 3px;
    }


    .value span {

      color:
        var(--muted);

      font-size: 13px;
    }


    /* =====================================================
       CONTACT
    ===================================================== */

    .contact {

      background:
        #07111e;
    }


    .contact-grid {

      display: grid;

      grid-template-columns:
        .8fr 1.2fr;

      gap: 50px;

      margin-top: 50px;
    }


    .contact-info {

      display: grid;

      gap: 14px;
    }


    .contact-item {

      padding: 20px;

      border:
        1px solid var(--border);

      border-radius: 13px;

      background:
        rgba(255,255,255,.025);
    }


    .contact-item strong {

      display: block;

      margin-bottom: 4px;
    }


    .contact-item span {

      color:
        var(--muted);

      font-size: 14px;
    }


    form {

      display: grid;

      gap: 14px;
    }


    .form-row {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 14px;
    }


    input,
    textarea,
    select {

      width: 100%;

      padding: 14px;

      color: white;

      outline: none;

      border:
        1px solid var(--border);

      border-radius: 10px;

      background:
        #091625;

      font-family: inherit;
    }


    input:focus,
    textarea:focus,
    select:focus {

      border-color:
        var(--blue-light);
    }


    textarea {

      min-height: 150px;

      resize: vertical;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    footer {

      padding:
        55px 0 25px;

      border-top:
        1px solid var(--border);
    }


    .footer-grid {

      display: grid;

      grid-template-columns:
        1.5fr 1fr 1fr 1fr;

      gap: 40px;

      margin-bottom: 40px;
    }


    .footer-brand p {

      color:
        var(--muted);

      max-width: 350px;

      margin-top: 15px;

      font-size: 14px;
    }


    footer h4 {

      margin-bottom: 15px;
    }


    footer ul {

      list-style: none;

      display: grid;

      gap: 9px;
    }


    footer li {

      color:
        var(--muted);

      font-size: 13px;
    }


    footer li a:hover {

      color:
        var(--blue-light);
    }


    .copyright {

      padding-top: 22px;

      border-top:
        1px solid var(--border);

      color:
        #708196;

      font-size: 12px;

      text-align: center;
    }


    /* =====================================================
       ANIMATION
    ===================================================== */

    .reveal {

      opacity: 0;

      transform:
        translateY(25px);

      transition:
        .7s ease;
    }


    .reveal.active {

      opacity: 1;

      transform:
        translateY(0);
    }


    /* ====================